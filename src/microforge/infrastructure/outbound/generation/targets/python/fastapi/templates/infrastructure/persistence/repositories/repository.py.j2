{% for method in methods %}
{% if method.name == "find_all" %}

    def find_all(self, page: PageRequest) -> PageResult[{{ domain_class_name }}]:
        statement = select({{ orm_class_name }}).order_by({{ orm_class_name }}.{{ id_field_name }})
        total = self.session.scalar(
            select(func.count()).select_from(statement.subquery())
        ) or 0
        records = self.session.scalars(
            statement.offset(page.offset).limit(page.limit)
        ).all()
        return PageResult(items={{ mapper_class_name }}.to_domain_list(records), total=total)
{% elif method.name == "find_by_id" %}

    def find_by_id(self, {{ method.params }}) -> {{ domain_class_name }} | None:
        record = self.session.get({{ orm_class_name }}, id)
        if record is None:
            return None
        return {{ mapper_class_name }}.to_domain(record)
{% elif method.name == "save" %}

    def save(self, {{ domain_module }}: {{ domain_class_name }}) -> {{ domain_class_name }}:
        record = {{ mapper_class_name }}.to_orm({{ domain_module }})
        self.session.add(record)
        self.session.flush()
        return {{ mapper_class_name }}.to_domain(record)
{% elif method.name == "update" %}

    def update(self, {{ domain_module }}: {{ domain_class_name }}) -> {{ domain_class_name }} | None:
        existing = self.session.get({{ orm_class_name }}, {{ domain_module }}.{{ id_field_name }})
        if existing is None:
            return None
        record = self.session.merge({{ mapper_class_name }}.to_orm({{ domain_module }}))
        self.session.flush()
        return {{ mapper_class_name }}.to_domain(record)
{% elif method.name == "patch_by_id" %}

