[project]
name = {{ package_name | tojson }}
version = "0.1.0"
description = {{ description | tojson }}
requires-python = {{ requires_python | tojson }}
dependencies = [
  "alembic>=1.14",
  "fastapi>=0.115",
  "pydantic>=2.0",
  "pydantic-settings>=2.6",
  "uvicorn[standard]>=0.30",
  "sqlalchemy>=2.0",
]

[project.optional-dependencies]
dev = [
  "httpx>=0.27",
  "mypy>=1.11",
  "pytest>=8.0",
  "ruff>=0.8",
]

[build-system]
requires = ["setuptools>=75"]
build-backend = "setuptools.build_meta"

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
extend-select = ["B"]
ignore = ["B008"]

[tool.mypy]
python_version = "3.12"
strict = true
