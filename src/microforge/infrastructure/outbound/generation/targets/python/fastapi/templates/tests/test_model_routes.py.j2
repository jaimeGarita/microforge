def test_list_{{ model.model_module }}_returns_empty_list(client: TestClient) -> None:
    response = client.get("{{ model.list_path }}")

    assert response.status_code == 200
    assert response.json() == {
        "items": [],
        "page": 1,
        "page_size": 20,
        "total": 0,
        "pages": 0,
    }

    invalid_page = client.get("{{ model.list_path }}", params={"page": 0})
    assert invalid_page.status_code == 422
    assert invalid_page.json()["error"]["code"] == "validation_error"

    oversized_page = client.get("{{ model.list_path }}", params={"page_size": 101})
    assert oversized_page.status_code == 422
{% if model.supports_crud %}


def test_{{ model.model_module }}_crud_lifecycle(client: TestClient) -> None:
{% if model.target_seeds %}
    with SessionLocal() as session:
{% for seed in model.target_seeds %}
        session.add({{ seed.class_name }}({{ seed.constructor_args }}))
{% endfor %}
        session.commit()

{% endif %}
    payload = {{ model.create_payload }}
    created = client.post("{{ model.list_path }}", json=payload)
    assert created.status_code == 201, created.text
    resource_id = created.json()["id"]

    fetched = client.get(f"{{ model.list_path }}/{resource_id}")
    assert fetched.status_code == 200

    patched = client.patch(
        f"{{ model.list_path }}/{resource_id}",
        json={"{{ model.patch_field }}": {{ model.patch_value }}},
    )
    assert patched.status_code == 200, patched.text
    assert patched.json()["{{ model.patch_field }}"] == {{ model.patch_value }}

    replaced = client.put(f"{{ model.list_path }}/{resource_id}", json=payload)
    assert replaced.status_code == 200, replaced.text

    deleted = client.delete(f"{{ model.list_path }}/{resource_id}")
    assert deleted.status_code == 204

    missing = client.get(f"{{ model.list_path }}/{resource_id}")
    assert missing.status_code == 404
    assert missing.json() == {
        "error": {
            "code": "entity_not_found",
            "message": f"{{ model.model_name }} with id '{resource_id}' was not found",
            "details": None,
        }
    }

    missing_patch = client.patch(
        f"{{ model.list_path }}/{resource_id}",
        json={"{{ model.patch_field }}": {{ model.patch_value }}},
    )
    assert missing_patch.status_code == 404

    missing_replace = client.put(f"{{ model.list_path }}/{resource_id}", json=payload)
    assert missing_replace.status_code == 404

    missing_delete = client.delete(f"{{ model.list_path }}/{resource_id}")
    assert missing_delete.status_code == 404

    invalid = client.post("{{ model.list_path }}", json={})
    assert invalid.status_code == 422
    assert invalid.json()["error"]["code"] == "validation_error"

    first = client.post("{{ model.list_path }}", json=payload)
    assert first.status_code == 201, first.text
    conflict = client.post("{{ model.list_path }}", json=payload)
    assert conflict.status_code == 409
    assert conflict.json() == {
        "error": {
            "code": "entity_conflict",
            "message": "The operation conflicts with an existing resource",
            "details": None,
        }
    }

    page = client.get("{{ model.list_path }}", params={"page": 1, "page_size": 1})
    assert page.status_code == 200
    assert len(page.json()["items"]) == 1
    assert page.json()["total"] == 1
    assert page.json()["pages"] == 1
{% endif %}
