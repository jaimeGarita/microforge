def test_list_{{ model.model_module }}_returns_empty_list(client: TestClient) -> None:
    response = client.get("{{ model.list_path }}")

    assert response.status_code == 200
    assert response.json() == []
{% if model.supports_crud %}


def test_{{ model.model_module }}_crud_lifecycle(client: TestClient) -> None:
{% if model.target_seeds %}
    with SessionLocal() as session:
{% for seed in model.target_seeds %}
        session.add({{ seed.class_name }}({{ seed.constructor_args }}))
{% endfor %}
        session.commit()

{% endif %}
    payload = {{ model.create_payload }}
    created = client.post("{{ model.list_path }}", json=payload)
    assert created.status_code == 201, created.text
    resource_id = created.json()["id"]

    fetched = client.get(f"{{ model.list_path }}/{resource_id}")
    assert fetched.status_code == 200

    patched = client.patch(
        f"{{ model.list_path }}/{resource_id}",
        json={"{{ model.patch_field }}": {{ model.patch_value }}},
    )
    assert patched.status_code == 200, patched.text
    assert patched.json()["{{ model.patch_field }}"] == {{ model.patch_value }}

    replaced = client.put(f"{{ model.list_path }}/{resource_id}", json=payload)
    assert replaced.status_code == 200, replaced.text

    deleted = client.delete(f"{{ model.list_path }}/{resource_id}")
    assert deleted.status_code == 204

    missing = client.get(f"{{ model.list_path }}/{resource_id}")
    assert missing.status_code == 404
{% endif %}
